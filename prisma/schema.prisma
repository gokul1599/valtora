generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  password      String
  plan          String         @default("free")
  onboarding    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  startups      Startup[]
  conversations AiConversation[]
  generations   AiGeneration[]
  notifications Notification[]
  documents     Document[]
  usage         Usage[]
  subscription  Subscription?
}

model Startup {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  idea          String
  audience      String?
  problem       String?
  monetization  String?
  stage         String           @default("idea")
  goal          String?
  email         String?
  status        String           @default("active")
  score         Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sections      StartupSection[]
  features      Feature[]
  tasks         Task[]
  conversations AiConversation[]
  generations   AiGeneration[]
  decisions     StartupDecision[]
  versions      StartupVersion[]
}

model StartupSection {
  id        String   @id @default(cuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  key       String
  title     String
  data      Json
  source    String   @default("ai")
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([startupId, key])
}

model Feature {
  id          String   @id @default(cuid())
  startupId   String
  startup     Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  name        String
  description String?
  priority    String   @default("medium")
  status      String   @default("proposed")
  effort      Int      @default(1)
  impact      Int      @default(1)
  confidence  Int      @default(1)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  startupId   String
  startup     Startup   @relation(fields: [startupId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    String    @default("medium")
  status      String    @default("todo")
  stage       String    @default("validation")
  order       Int       @default(0)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model StartupDecision {
  id        String   @id @default(cuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  decision  String
  reasoning String?
  impact    Json
  createdAt DateTime @default(now())
}

model StartupVersion {
  id        String   @id @default(cuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  version   Int
  label     String
  summary   String?
  snapshot  Json
  createdAt DateTime @default(now())
}

model AiConversation {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  startupId    String?
  startup      Startup?    @relation(fields: [startupId], references: [id], onDelete: SetNull)
  title        String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  messages     AiMessage[]
}

model AiMessage {
  id             String      @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  data           Json?
  createdAt      DateTime    @default(now())
}

model AiGeneration {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startupId  String?
  startup    Startup? @relation(fields: [startupId], references: [id], onDelete: SetNull)
  action     String
  model      String?  @default("")
  status     String   @default("success")
  error      String?
  tokensIn   Int      @default(0)
  tokensOut  Int      @default(0)
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startupId String?
  name      String
  mime      String
  size      Int      @default(0)
  url       String?
  createdAt DateTime @default(now())
}

model Usage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       String
  generations Int      @default(0)
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)

  @@unique([userId, month])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String   @default("free")
  status    String   @default("active")
  provider  String?
  renewsAt  DateTime?
  createdAt DateTime @default(now())
}